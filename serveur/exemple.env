# Copier ce fichier en « .env » (même dossier) et le remplir. Le fichier .env n'est jamais commité.
# Sans SUPABASE_URL ni SUPABASE_SECRET_KEY : serveur de développement (pseudos sans mot de passe).

# Supabase → Project Settings → Data API : « Project URL ».
SUPABASE_URL=
# Supabase → Project Settings → API Keys : une clé « secret » (sb_secret_…). SECRÈTE : jamais
# dans le jeu, jamais dans un message, jamais dans le dépôt.
SUPABASE_SECRET_KEY=
# Nom de ce poste, montré si l'autre poste a déjà un serveur lancé.
RV_POSTE=
